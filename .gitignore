# preprocessing
.venv/
__pycache__/
*.egg-info/

# Index artefacts. Derived data, and large with it: out-sample/ is 5.1 GB, most
# of it the thumbnails. All of it is reproducible from the images with
# `bodypose run`, and none of it is reviewable in a diff.
#
# Unanchored on purpose — `--out` defaults to `out` relative to wherever the CLI
# was run, so these directories do not always land under preprocessing/.
out/
out-*/

# Datasets and the indexes built from them. INPUT/ holds symlinks to image
# libraries that live elsewhere; OUTPUT/ is entirely derived data. Both READMEs
# are kept, since they document the layout the CLI depends on.
INPUT/*
!INPUT/README.md
OUTPUT/*
!OUTPUT/README.md

# live
node_modules/
dist/
live/public/mediapipe/

.DS_Store

INPUT/*
!INPUT/README.md
OUTPUT/*
!OUTPUT/README.md